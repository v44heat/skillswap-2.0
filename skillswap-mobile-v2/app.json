{
  "expo": {
    "name": "SkillSwap",
    "slug": "skillswap",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skillswap.app"
    },
    "android": {
      "package": "com.skillswap.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1A"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
